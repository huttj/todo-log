// Template — the real wrangler.jsonc is untracked (it holds account-specific
// identifiers). Local dev: `cp wrangler.jsonc.example wrangler.jsonc` and fill
// in the placeholders. CI materializes it from repo secrets (see
// .github/workflows/deploy.yml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todolog",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "todolo.gg", "custom_domain": true },
    { "pattern": "www.todolo.gg", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todolog",
      "database_id": "__D1_DATABASE_ID__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "__R2_BUCKET_NAME__"
    }
  ],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORS", "index_name": "todolog-search" }],
  "send_email": [{ "name": "EMAIL", "remote": true }],
  "triggers": {
    // Sweep: heal untranscribed segments, distill pending corrections.
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "TIMEZONE": "America/Los_Angeles",
    "VAPID_PUBLIC_KEY": "BMtV_2dTx1F-T2OwRZjJGx4nUGIZp6miOxzxyqrqG2VZETx2_nwVQOp00uHiA1SahbJUBmqDXPAEi6lDkiq54CQ"
  }
  // Secrets (wrangler secret put / .dev.vars):
  //   ANTHROPIC_API_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_SECRET,
  //   ALLOWLIST_EMAILS (comma-separated admin emails),
  //   VAPID_PRIVATE_KEY (P-256 JWK JSON for web push),
  //   KEY_VAULT_SECRET (optional — wraps stored BYOK keys; SESSION_SECRET otherwise)
}
