{
  "name": "todolog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply todolog --local",
    "db:migrate": "wrangler d1 migrations apply todolog --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "hono": "^4.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.10.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.27.0"
  }
}
